// See https://containers.dev/implementors/json_reference/ for configuration reference
{
	"name": "Lapis Language Website",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"postStartCommand": "npm install && git config --global --get-all safe.directory | grep -q \"^${containerWorkspaceFolder}$\" || git config --global --add safe.directory ${containerWorkspaceFolder} && bash .devcontainer/ensure-ollama.sh",
    // Persists the Ollama home directory (auth keys, cloud model manifests) across rebuilds.
    "mounts": [
        "source=${localWorkspaceFolderBasename}-ollama,target=/home/vscode/.ollama,type=volume"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "Nuxtr.nuxtr-vscode",
                "Vue.volar",
                "EditorConfig.EditorConfig",
                "github.vscode-github-actions",
                "bierner.markdown-mermaid",
                "bpruitt-goddard.mermaid-markdown-syntax-highlighting",
                "hediet.vscode-drawio",
                "vitest.explorer",
                "kingwl.vscode-vitest-runner",
                "bradlc.vscode-tailwindcss",
                "Ollama.ollama",
                "xadamxk.prune-stale-git-branches"
            ],
            "settings": {
                "ollama.endpoint": "http://127.0.0.1:11434"
            }
        }
    },
    // Features to add to the dev container. More info: https://containers.dev/features.
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "latest"
        }
    },
    "remoteUser": "node"
}
